# Copy to .env for local runs. In the cloud, set these as environment variables
# backed by Secret Manager / Secrets Manager / Key Vault.

# dev | staging | production. Outside dev the app refuses insecure settings.
ENVIRONMENT=dev
COMPANY_NAME=Example Corp
PUBLIC_BASE_URL=http://localhost:8080
# Bootstrap admin token: dev only. Create scoped keys with `ap-agent apikey create`.
API_TOKEN=change-me-long-random
WEBHOOK_SECRET=change-me-webhook-secret
SESSION_SECRET=change-me-session-secret
BANK_FINGERPRINT_PEPPER=change-me-pepper
# none (dev) | oidc | iap | alb | easyauth
AUTH_MODE=none
OIDC_ISSUER=
OIDC_AUDIENCE=
IAP_AUDIENCE=
ALB_ARN=
RBAC_FILE=config/rbac.yaml
ENTITIES_FILE=config/entities.yaml
# db (Fernet-encrypted) | gcp | aws | azure
SECRET_STORE=db
TOKEN_ENCRYPTION_KEY=
# inline (dev) | separate (production: run `ap-agent execute-payments` with its own ERP credentials)
PAYMENT_EXECUTION=inline
RETENTION_YEARS=7
LLM_INFERENCE_GEO=
DATABASE_URL=sqlite:///./data/ap_agent.db
# local | s3 | gcs | azure
BLOB_BACKEND=local
BLOB_BUCKET=./data/blobs
POLICY_FILE=config/policy.yaml

# ---- Claude: anthropic | bedrock | vertex | foundry
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_FALLBACK_MODEL=claude-opus-5
LLM_AGENT_EFFORT=high
LLM_EXTRACTION_EFFORT=medium
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
VERTEX_PROJECT_ID=
VERTEX_REGION=global
FOUNDRY_RESOURCE=
# empty = managed identity / Entra ID
FOUNDRY_API_KEY=

# ---- ERP: netsuite | dynamics_bc | quickbooks | xero | memory
ERP_PROVIDER=memory
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_PRIVATE_KEY=
NETSUITE_PAYMENT_ACCOUNT_ID=
NETSUITE_SUBSIDIARY_ID=
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT=production
DYNAMICS_COMPANY_ID=
DYNAMICS_PAYMENT_JOURNAL_ID=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_SANDBOX=false
QUICKBOOKS_BANK_ACCOUNT_ID=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_REFRESH_TOKEN=
XERO_BANK_ACCOUNT_CODE=

# ---- Mailbox: gmail | outlook | memory
MAIL_PROVIDER=memory
# draft = humans review replies; send = agent sends
MAIL_REPLY_MODE=draft
GMAIL_USER=
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
